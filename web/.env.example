# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_...). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase → Connect → "Session pooler" (port 5432) or direct connection.
# Used by the app server and the worker (pg-boss needs a session connection).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: richer YouTube metadata (Google Cloud → YouTube Data API v3)
YOUTUBE_API_KEY=
